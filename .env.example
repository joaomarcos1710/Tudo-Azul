# Copie para .env.local e preencha com os dados públicos do projeto Supabase.
# Nunca coloque uma secret key nem a service_role neste arquivo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: monitoramento de erros (Sentry). Só vale em produção; sem ele, nada é enviado.
# O DSN fica no Sentry em Project Settings → Client Keys. Configure no Vercel (Environment Variables), não aqui.
VITE_SENTRY_DSN=
